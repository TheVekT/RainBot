# Django Settings
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
DJANGO_HOST=0.0.0.0
DJANGO_PORT=8000

# Database Settings
DB_NAME=rainbot_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Bot Tokens
DISCORD_BOT_TOKEN=your_discord_bot_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Browser & Scrapper Settings
# CHROME_BINARY=  # Path to google-chrome or chromium binary
# CHROMEDRIVER_VERSION=  # Major version (e.g. 120, 147), leave empty for auto-detection

# Orchestrator & gRPC Settings
GRPC_PORT=50051

# Cloudflare Tunnel Settings (Optional, uncomment if using)
# CLOUDFLARE_TOKEN=your_cloudflare_tunnel_token_here