# RainBot Environment Configuration
# Copy this file to .env and fill in your values
# Or set these as system environment variables

# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Telegram Bot Token
TELEGRAM_TOKEN=your_telegram_bot_token_here

# WebSocket Server Host (optional, defaults to 192.168.0.106)
RAINBOT_HOST=192.168.0.106

# WebSocket Server Port (optional, adjusted in code if needed)
# RAINBOT_PORT=8765
